# Copy this file to .env to configure the backend.

# Port the Express API runs on.
PORT=5000

# Optional. If set and reachable, EcoVision stores data in MongoDB.
# If omitted or unreachable, it automatically falls back to a local
# JSON file at backend/data/db.json — no MongoDB installation required.
# MONGODB_URI=mongodb://127.0.0.1:27017/ecovision
